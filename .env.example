# Copy to .env or pass these as PowerShell parameters.
# Do not commit real keys, function keys, connection strings, or tokens.

SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
RESOURCE_GROUP=rg-reccia-graph-ingestion
LOCATION=eastus

NAME_PREFIX=reccia
SEARCH_SERVICE=reccia-search-<suffix>
DOCUMENT_INTELLIGENCE_ACCOUNT=reccia-docintel-<suffix>
VISION_ACCOUNT=reccia-vision-<suffix>
OPENAI_ACCOUNT=reccia-openai-<suffix>
OPENAI_DEPLOYMENT=gpt-4.1-mini
FUNCTION_APP=reccia-agent-api-<suffix>
STORAGE_ACCOUNT=recciafn<suffix>

DOCUMENT_INDEX=reccia-documents
IMAGE_INDEX=reccia-images

# SharePoint document library drive ID and folders.
DRIVE_ID=<graph-drive-id>
SOURCE_FOLDER=Source Documents
IMAGES_FOLDER=Extracted Images

# Power Platform / Copilot Studio
POWER_PLATFORM_ENVIRONMENT_URL=https://<org>.crm.dynamics.com/
POWER_PLATFORM_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
COPILOT_SCHEMA_NAME=reccia_RenewableComplianceReviewer
